# Public app URL used for auth redirects, Stripe return URLs, and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
# The anon key is safe to expose to the browser because Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never import this into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Developers → API keys)
# Publishable key is public. Secret key and webhook secret stay on the server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Avyro monthly price (kept for backward compatibility).
STRIPE_PRICE_ID=price_...
# Velto monthly price. An org can subscribe to Avyro, Velto, Rovyn, or any combination.
STRIPE_VELTO_PRICE_ID=price_...
# Rovyn monthly price.
STRIPE_ROVYN_PRICE_ID=price_...

# Resend (API Keys)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=AYV WRLD <noreply@yourdomain.com>
