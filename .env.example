# Public app URL used for auth redirects, Stripe return URLs, and invite links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
# The anon key is safe to expose to the browser because Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never import this into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (Developers → API keys)
# Publishable key is public. Secret key and webhook secret stay on the server.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Avyro monthly price (kept for backward compatibility).
STRIPE_PRICE_ID=price_...
# Velto monthly price. An org can subscribe to Avyro, Velto, Rovyn, or any combination.
STRIPE_VELTO_PRICE_ID=price_...
# Rovyn monthly price.
STRIPE_ROVYN_PRICE_ID=price_...
# Orvyn monthly price.
STRIPE_ORVYN_PRICE_ID=price_...
# Nexro monthly price (€39).
STRIPE_NEXRO_PRICE_ID=price_...
# Ravelo monthly price (€39).
STRIPE_RAVELO_PRICE_ID=price_...
# Growth monthly price (€79, any three modules).
STRIPE_GROWTH_PRICE_ID=price_...
# Full stack monthly price. Only used when NEXT_PUBLIC_LEGACY_MODULES=true.
STRIPE_FULL_STACK_PRICE_ID=price_...
# AYV Onderhoud. Create these in Stripe. All three include a 7-day trial.
# Monthly €49, yearly €490, founder €29 per month. Amounts exclude btw. Never put secret keys here.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_PRICE_FOUNDER=price_...

# Resend (API Keys)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=AYV WRLD <noreply@yourdomain.com>

# Vercel Cron sends this as Authorization: Bearer <secret>.
CRON_SECRET=generate-a-long-random-string
